# .env.template 

# --- [사용자 정보] ---
KIS_HTS_ID=YOUR_HTS_ID_HERE
KIS_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/114.0.0.0 Safari/537.36"

# --- [모의투자 (Virtual)] ---
KIS_MOCK_APP_KEY=PASTE_YOUR_MOCK_APP_KEY
KIS_MOCK_APP_SECRET=PASTE_YOUR_MOCK_SECRET
KIS_MOCK_ACC_STOCK=00000000
KIS_MOCK_ACC_FUTURE=00000000

# --- [실전투자 (Real)] ---
KIS_REAL_APP_KEY=PASTE_YOUR_REAL_APP_KEY
KIS_REAL_APP_SECRET=PASTE_YOUR_REAL_SECRET
KIS_REAL_ACC_STOCK=00000000
KIS_REAL_ACC_FUTURE=00000000

# --- [계좌 뒷자리] ---
KIS_ACC_PRODUCT_CODE=01

# --- [재무 데이터 API] ---
# OpenDART 키 (둘 중 하나만 사용해도 됨)
OPEN_DART_API_KEY=
DART_API_KEY=

# 커스텀 재무 API를 쓸 경우
FINANCIAL_API_URL=
FINANCIAL_API_METHOD=GET
FINANCIAL_API_DATA_KEY=data

# --- [Slack 알림] ---
SLACK_WEBHOOK_URL=
SLACK_NOTIFICATIONS_ENABLED=true
SLACK_TIMEOUT_SEC=3